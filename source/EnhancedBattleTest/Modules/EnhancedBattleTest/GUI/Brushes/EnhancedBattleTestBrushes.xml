<Brushes>
  <Brush Name="EnhancedBattleTest.Popup">
    <Layers>
      <BrushLayer Name="Default" Sprite="StdAssets\standart_popup" />
      <BrushLayer Name="Frame" ExtendLeft="27" ExtendRight="26" ExtendTop="27" ExtendBottom="29" Sprite="Frame1_frame" OverlayMethod="CoverWithTexture" OverlaySprite="stone_texture_overlay" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" />
        <BrushLayer Name="Frame" />
      </Style>
    </Styles>
  </Brush>
  <Brush Name="EnhancedBattleTest.MissionMenuBrush">
    <Layers>
      <BrushLayer Name="Default" Sprite="Frame1_canvas" />
      <BrushLayer Name="Frame" ExtendTop="27" ExtendLeft="26" ExtendRight="27" ExtendBottom="29" Sprite="Frame1_frame" OverlayMethod="CoverWithTexture" OverlaySprite="stone_texture_overlay"/>
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" AlphaFactor="1"/>
        <BrushLayer Name="Frame" AlphaFactor="1"/>
      </Style>
    </Styles>
  </Brush>
  <Brush Name="EnhancedBattleTest.TransparentBrush">
    <Layers>
      <BrushLayer Name="Default" Sprite="Frame1_canvas" />
      <BrushLayer Name="Frame" ExtendTop="27" ExtendLeft="26" ExtendRight="27" ExtendBottom="29" Sprite="Frame1_frame" OverlayMethod="CoverWithTexture" OverlaySprite="stone_texture_overlay"/>
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" AlphaFactor="0"/>
        <BrushLayer Name="Frame" AlphaFactor="0"/>
      </Style>
    </Styles>
  </Brush>
  <Brush Name="EnhancedBattleTest.BannerButton">
    <Layers>
      <BrushLayer Name="Default" Sprite="StdAssets\banner_new" OverlayXOffset="0" OverlayYOffset="-3" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" />
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Default" ColorFactor="1.25" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" ColorFactor="0.9" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Default" />
      </Style>
    </Styles>
  </Brush>
</Brushes>
