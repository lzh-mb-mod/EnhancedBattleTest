<Prefab>
  <Window>
    <ListPanel WidthSizePolicy="Fixed" SuggestedWidth="540" HeightSizePolicy="CoverChildren" MarginLeft="10" MarginTop="20" LayoutImp.LayoutMethod="VerticalTopToBottom">
      <Children>

        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Top" MarginLeft="10" MarginRight="10" LayoutImp.LayoutMethod="HorizontalLeftToRight">
          <Children>
            <TextWidget DataSource="{TroopGroupName}" Text="@Text" WidthSizePolicy="Fixed" SuggestedWidth="120" HeightSizePolicy="CoverChildren" HorizontalAlignment="Right" Brush="SPOptions.GameKeysGroup.Title.Text" />
            <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="2" VerticalAlignment="Center" MarginLeft="15" Brush="SPOptions.CollapserLine" />
          </Children>
        </ListPanel>

        <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" MarginTop="20" LayoutImp.LayoutMethod="VerticalTopToBottom">
          <Children>
            
            <EnhancedBattleTestTroopList />

          </Children>
        </ListPanel>

      </Children>
    </ListPanel>
  </Window>
</Prefab>