                    <RichTextWidget DataSource="{MinExposureText}" Text="@Text" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="190" VerticalAlignment="Center" Brush="CustomBattle.Value.Text" />
