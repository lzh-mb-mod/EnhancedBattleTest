<Prefab>
  <Window>
    <ListPanel WidthSizePolicy="Fixed" SuggestedWidth="560" HeightSizePolicy="CoverChildren" MarginLeft="10" MarginTop="20" MarginBottom="25" LayoutImp.LayoutMethod="VerticalTopToBottom">
      <Children>
        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" LayoutImp.LayoutMethod="HorizontalLeftToRight">
          <Children>
            <PartyHeaderToggleWidget DoNotPassEventsToChildren="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" CollapseIndicator="PartyName\CollapseIndicator" WidgetToClose="..\..\PartyContent" ListPanel="..\..\PartyContent" RenderLate="true" UpdateChildrenStates="true">
              <Children>
                <RichTextWidget Id="PartyName" DataSource="{Name}" Text="@Text" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" Brush="SPOptions.GameKeysGroup.Title.Text" Brush.TextHorizontalAlignment="Left" MarginLeft="45">
                  <Children>
                    <BrushWidget Id="CollapseIndicator" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedHeight="19" SuggestedWidth="19" VerticalAlignment="Center" PositionXOffset="-26" Brush="SPOptions.GameKeysgroup.ExpandIndicator" OverrideDefaultStateSwitchingEnabled="true" />
                  </Children>
                </RichTextWidget>
              </Children>
            </PartyHeaderToggleWidget>
            <ButtonWidget IsVisible="@CanRemove" DoNotPassEventsToChildren="true" Command.Click="RemoveParty" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="160" SuggestedHeight="50" Brush="WideButton.Flat" UpdateChildrenStates="true">
              <Children>
                <TextWidget DataSource="{RemovePartyText}" Text="@Text" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" HorizontalAlignment="Center" VerticalAlignment="Center" Brush="MPTeamSelection.SpectateButton.Text" />
              </Children>
            </ButtonWidget>
          </Children>
        </ListPanel>

        <ListPanel Id="PartyContent" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" LayoutImp.LayoutMethod="VerticalTopToBottom">
          <Children>
            <ButtonWidget DoNotPassEventsToChildren="true" Command.Click="ImportCampaignParty" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="300" SuggestedHeight="50" MarginLeft="20" MarginTop="10" Brush="WideButton.Flat" UpdateChildrenStates="true">
              <Children>
                <TextWidget DataSource="{ImportPartyText}" Text="@Text" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" HorizontalAlignment="Center" VerticalAlignment="Center" Brush="MPTeamSelection.SpectateButton.Text" />
              </Children>
            </ButtonWidget>

        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="10" LayoutImp.LayoutMethod="HorizontalLeftToRight">
          <Children>
            <ButtonWidget DoNotPassEventsToChildren="true" Command.Click="EditBanner" IsEnabled="@IsBannerEditorEnabled" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="73" SuggestedHeight="102" MarginLeft="20" UpdateChildrenStates="true">
              <Children>
                <MaskedTextureWidget DataSource="{Banner}" DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="85" SuggestedHeight="102" HorizontalAlignment="Center" VerticalAlignment="Center" Brush="EnhancedBattleTest.BannerButton" AdditionalArgs="@AdditionalArgs" ImageId="@Id" TextureProviderName="@TextureProviderName" />
              </Children>
            </ButtonWidget>
            <RichTextWidget DataSource="{CustomBannerText}" Text="@Text" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" MarginLeft="25" HorizontalAlignment="Left" VerticalAlignment="Center" Brush="CustomBattle.Value.Text" />
            <ButtonWidget DataSource="{UseCustomBanner}" IsSelected="@Value" ButtonType="Toggle" DoNotPassEventsToChildren="true" ToggleIndicator="ToggleIndicator" MarginLeft="15" HorizontalAlignment="Left" VerticalAlignment="Center" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="50" SuggestedHeight="50" Brush="SPOptions.Checkbox.Empty.Button">
              <Children>
                <ImageWidget Id="ToggleIndicator" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="SPOptions.Checkbox.Full.Button" />
              </Children>
            </ButtonWidget>
          </Children>
        </ListPanel>

        <ListPanel IsVisible="@CanConfigureArmy" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" MarginLeft="20" MarginTop="10" LayoutImp.LayoutMethod="HorizontalLeftToRight">
          <Children>
            <RichTextWidget DataSource="{InArmyText}" Text="@Text" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" VerticalAlignment="Center" Brush="CustomBattle.Value.Text" />
            <ButtonWidget DataSource="{InArmy}" IsSelected="@Value" ButtonType="Toggle" DoNotPassEventsToChildren="true" ToggleIndicator="ToggleIndicator" MarginLeft="15" VerticalAlignment="Center" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="50" SuggestedHeight="50" Brush="SPOptions.Checkbox.Empty.Button">
              <Children>
                <ImageWidget Id="ToggleIndicator" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="SPOptions.Checkbox.Full.Button" />
              </Children>
            </ButtonWidget>
          </Children>
        </ListPanel>

        <ListPanel IsVisible="@IsPlayerCharacterVisible" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" MarginLeft="20" MarginTop="10" LayoutImp.LayoutMethod="VerticalTopToBottom">
          <Children>
            <RichTextWidget DataSource="{PlayerCharacterText}" Text="@Text" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" Brush="SPOptions.GameKeysGroup.Title.Text" />
            <EnhancedBattleTestCharacterButton DataSource="{PlayerCharacter}" MarginTop="10" />
          </Children>
        </ListPanel>

            <EnhancedBattleTestGeneralTroopGroup DataSource="{Generals}" />
            <EnhancedBattleTestNonGeneralTroopGroup DataSource="{Troops}" />
          </Children>
        </ListPanel>
      </Children>
    </ListPanel>
  </Window>
</Prefab>
